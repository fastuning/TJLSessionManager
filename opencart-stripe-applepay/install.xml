<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>Stripe Apple Pay - Product Page Button</name>
    <code>stripe_applepay_product_button</code>
    <version>1.0.4</version>
    <author>Custom Development</author>
    <link>https://www.stripe.com</link>

    <!-- Add Apple Pay button and scripts to product page -->
    <file path="catalog/view/theme/*/template/product/product.twig">
        <operation>
            <search><![CDATA[<a id="button-cart"]]></search>
            <add position="before"><![CDATA[
            <!-- Stripe Apple Pay Button -->
            <div id="stripe-applepay-button-container" style="margin-bottom: 15px;"></div>
            <div id="stripe-applepay-divider" style="text-align: center; margin: 15px 0; display: none;">
                <span style="background: #fff; padding: 0 10px; color: #999;">O</span>
            </div>
            <!-- Stripe Scripts -->
            <script>
            (function() {
                // Fetch Stripe configuration from server
                fetch('index.php?route=extension/module/stripe_product_payment/getConfig')
                    .then(function(response) { return response.json(); })
                    .then(function(config) {
                        if (!config.enabled || !config.publishable_key) {
                            console.log('Stripe Apple Pay not configured');
                            return;
                        }

                        // Inject meta tag with publishable key
                        if (!document.querySelector('meta[name="stripe-publishable-key"]')) {
                            var meta = document.createElement('meta');
                            meta.name = 'stripe-publishable-key';
                            meta.content = config.publishable_key;
                            document.head.appendChild(meta);
                        }

                        // Load Stripe.js
                        if (typeof Stripe === 'undefined') {
                            var stripeScript = document.createElement('script');
                            stripeScript.src = 'https://js.stripe.com/v3/';
                            stripeScript.onload = function() { loadStripeApplePay(); };
                            document.head.appendChild(stripeScript);
                        } else {
                            loadStripeApplePay();
                        }

                        function loadStripeApplePay() {
                            var applePayScript = document.createElement('script');
                            applePayScript.src = 'catalog/view/javascript/stripe_applepay.js';
                            applePayScript.onload = function() {
                                if (typeof StripeProductApplePay !== 'undefined') {
                                    var productData = {
                                        product_id: {{ product_id }},
                                        {% if options %}
                                        options: {{ options|json_encode|raw }},
                                        {% endif %}
                                        quantity_selector: '#product-quantity, #input-quantity',
                                        price_element: '#product .price-new, #product .price',
                                        currency: '{{ currency_code }}',
                                        ajax_url: 'index.php?route=extension/module/stripe_product_payment/process'
                                    };
                                    StripeProductApplePay.init(productData);
                                }
                            };
                            document.head.appendChild(applePayScript);
                        }
                    })
                    .catch(function(error) {
                        console.error('Failed to load Stripe config:', error);
                    });
            })();
            </script>
            ]]></add>
        </operation>
    </file>

    <!-- Add Apple Pay domain association meta tag -->
    <file path="catalog/view/theme/*/template/common/header.twig">
        <operation>
            <search><![CDATA[<head>]]></search>
            <add position="after"><![CDATA[
<meta name="apple-pay-domain-association-file" content="/.well-known/apple-developer-merchantid-domain-association">
            ]]></add>
        </operation>
    </file>
</modification>
